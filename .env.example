HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0
ENABLE_HTTPS=0
APP_ENV=development
TRUST_PROXY=0
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
CLASSPULSE_DB_PATH=classpulse/data/classpulse.db
