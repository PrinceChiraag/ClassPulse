
# ==========================================
# ClassPulse Environment Configuration
# ==========================================

# ==========================================
# Security
# ==========================================

# Development placeholder only.
# Generate a unique secret of at least 32 characters for production.
# Never commit your real SECRET_KEY.
SECRET_KEY=replace-with-a-long-random-value

# ==========================================
# Server Configuration
# ==========================================

HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# ==========================================
# Application Environment
# ==========================================

# Use development locally.
# Set to production on your deployment platform.
APP_ENV=development

# Enable only when HTTPS is configured.
ENABLE_HTTPS=0

# Set to 1 when running behind a trusted reverse proxy.
TRUST_PROXY=0

# ==========================================
# Local Database Configuration
# ==========================================

# Used for local SQLite development.
CLASSPULSE_DB_PATH=classpulse/data/classpulse.db

# ==========================================
# Supabase PostgreSQL Configuration
# ==========================================

# Required for production deployment.
# Use your Supabase PostgreSQL connection string.
# Prefer the Supabase connection pooler for supported deployment environments.
# Never put your actual password or connection URL in this example file.
DATABASE_URL=

# Keep legacy SQLite account importing disabled by default.
# Set to 1 only when you intentionally want to import legacy accounts.
CLASSPULSE_IMPORT_LEGACY_SQLITE=0

# ==========================================
# HTTPS Certificate Configuration
# ==========================================

SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# ==========================================
# Phone Detection Model
# ==========================================

CLASSPULSE_PHONE_MODEL=models/phone_best.pt
